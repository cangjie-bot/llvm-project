Test for enabling truncated profile data in continuous mode

RUN: not llvm-profdata merge %p/Inputs/continuous-mode.profraw -o %t.profdata 2>&1
CHECK: warning: {{.+}}: truncated profile data
CHECK: error: no profile can be merged

RUN: not llvm-profdata show %p/Inputs/continuous-mode.profraw 2>&1
CHECK: error: {{.+}}: truncated profile data

RUN: llvm-profdata merge --enable-truncated-profile %p/Inputs/continuous-mode.profraw -o %t.profdata 2>&1
CHECK-NOT: warning: {{.+}}: truncated profile data
CHECK-NOT: error: no profile can be merged

RUN: llvm-profdata show --enable-truncated-profile %p/Inputs/continuous-mode.profraw 2>&1
CHECK-NOT: error: {{.+}}: truncated profile data
